{
	email admin@yorecebimde.com
	servers {
		protocols h1 h2 h3
	}
}

# ----- Staging (Faz 1) -----

# Web — staging
yorecebimde-staging.gkteches.com {
	reverse_proxy web:3000
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(self)"
		-Server
	}
}

# API — staging
api.yorecebimde-staging.gkteches.com {
	reverse_proxy api:4000
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Access-Control-Allow-Origin "https://yorecebimde-staging.gkteches.com"
		Access-Control-Allow-Credentials "true"
	}
}

