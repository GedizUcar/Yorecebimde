{
  "name": "@yorecebimde/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "generate": "tsx src/scripts/generate-migration.ts",
    "generate:raw": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx seed/index.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "better-auth": "^1.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "postgres": "^3.4.5",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "^2.1.0"
  }
}
