# ===================================================================
# Yörecebimde — Environment Variables Example
# ===================================================================
# Bu dosyayı `.env` olarak kopyala ve gerçek değerlerle doldur.
# Asla gerçek secret'ları repo'ya commit etme.
# ===================================================================

# ---- Node / Runtime ----
NODE_ENV=development
TZ=Europe/Istanbul

# ---- Postgres (lokal: yorecebimde unique port range) ----
DATABASE_URL=postgresql://yorecebimde:yorecebimde@localhost:5434/yorecebimde
DATABASE_READ_REPLICA_URL=
DATABASE_MAX_POOL_SIZE=20
DATABASE_SSL=false

# ---- Redis (cache + BullMQ + session) ----
REDIS_URL=redis://localhost:6380
REDIS_TLS=false

# ---- Better-Auth ----
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Ek CORS allowlist (panel subdomain vs.) — virgulle ayrilmis. Bos birakilirsa
# sadece BETTER_AUTH_URL kabul edilir. Staging icin: https://panel.yorecebimde-staging.gkteches.com
CORS_EXTRA_ORIGINS=
SESSION_COOKIE_NAME=yorecebimde_session
SESSION_MAX_AGE_DAYS=30

# ---- JWT (mobil API için) ----
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=replace-with-different-secret-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Encryption (PII at-rest: TC kimlik, IBAN, vs.) ----
ENCRYPTION_KEY=replace-with-32-byte-key-base64
ENCRYPTION_ALGORITHM=aes-256-gcm

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yorecebimde
MINIO_PUBLIC_URL=http://localhost:9100

# ---- Meilisearch ----
MEILISEARCH_HOST=http://localhost:7710
MEILISEARCH_API_KEY=masterKey
MEILISEARCH_INDEX_PREFIX=yorecebimde_

# ---- Iyzico ----
IYZICO_API_KEY=sandbox-xxx
IYZICO_SECRET_KEY=sandbox-xxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:3000/api/payment/iyzico/callback

# ---- Nilvera (e-Fatura / e-Arşiv) ----
NILVERA_API_KEY=
NILVERA_BASE_URL=https://api.nilvera.com
NILVERA_TEST_MODE=true

# ---- NetGSM (SMS) ----
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=YORECEBIM
NETGSM_BASE_URL=https://api.netgsm.com.tr

# ---- Resend (email) ----
RESEND_API_KEY=
RESEND_FROM="Yörecebimde <noreply@yorecebimde.com>"

# ---- Expo Push Notifications ----
EXPO_ACCESS_TOKEN=

# ---- Gemini AI ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Sentry (self-host) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Observability ----
LOG_LEVEL=info
LOG_PRETTY=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Rate Limit ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# ---- Public URLs ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Seller + admin paneli için subdomain. Bos birakirsan host-split kapali
# (localhost dev). Staging: https://panel.yorecebimde-staging.gkteches.com
NEXT_PUBLIC_PANEL_URL=
NEXT_PUBLIC_CDN_URL=http://localhost:9000/yorecebimde
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_SUPPORTED_LOCALES=tr,en
NEXT_PUBLIC_SENTRY_DSN=

# ---- Business Rules (configurable defaults) ----
ESCROW_AUTO_RELEASE_DAYS=14
CART_RESERVATION_MINUTES=15
BOOST_RATIO_PERCENT=20
MAX_PRODUCT_IMAGES=3
LOW_STOCK_DEFAULT_THRESHOLD=5
DISPUTE_SELLER_RESPONSE_DAYS=3
DISPUTE_AUTO_ESCALATE_DAYS=7

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=
